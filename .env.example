# Embodied Platform Console — environment variables.
# Copy to .env and fill in for any real deployment; every value is optional in
# local dev (scripts/run.sh falls back to loud dev defaults).

# HMAC secret that signs write-session principals. REQUIRED in production —
# run.sh generates an ephemeral one otherwise, so sessions die on restart.
XINGJU_EMBODIED_PLATFORM_AUTH_SECRET=

# Login passcode for POST /api/embodied-platform/session. REQUIRED in
# production — run.sh falls back to the dev passcode 'ground-control-dev'.
XINGJU_EMBODIED_PLATFORM_LOGIN_PASSCODE=

# Comma-separated CORS allow-list (e.g. https://console.example.com). Empty =
# no cross-origin callers (same-origin SPA needs none).
XINGJU_CORS_ORIGINS=

# Data root for the platform JSON store (state.json + lock).
XINGJU_EMBODIED_PLATFORM_DATA_ROOT=

# Data root for labeler per-annotator JSONL segments + episode assets.
XINGJU_EMBODIED_DATA_ROOT=

# Cache root for materialized episode clips (safe to wipe; excluded from backups).
XINGJU_EMBODIED_CACHE_ROOT=

# Root of a locally-recorded LeRobot dataset to expose as "recorded" (optional).
XINGJU_EMBODIED_DATASET_ROOT=

# Postgres DSN for the multi-instance state backend (Part B, optional) —
# set -> Postgres repository; unset -> JSON file store (today's default).
XINGJU_EMBODIED_PLATFORM_DSN=
